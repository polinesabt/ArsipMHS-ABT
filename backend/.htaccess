Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Also protects files left behind by older FTP deployments.
  RewriteRule ^(scripts|database|vendor|storage|config)(/|$|[[:space:]]) - [F,NC]
</IfModule>

<FilesMatch "\.(sql|phar|lock|log|bak|backup|ini|env|json|md|txt|xml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
